# Copy to .env. Examples use reserved addresses and contain no credentials.
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/callback
ALLOWED_EMAILS=reader@example.com,admin@example.com
ACADTRACK_LOCAL_LOGIN=0
ACADTRACK_HTTPS=0
ACADTRACK_DB=data/acadtrack.db

# Optional. Leave empty to make no Gemini requests.
GEMINI_API_KEYS=
